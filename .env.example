# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── SMTP (Mailpit for local dev, injected from Kubernetes secret in cluster) ─
SMTP_HOST=localhost         # cluster: email-mailpit.email-mailpit.svc.cluster.local
SMTP_PORT=1025
SMTP_FROM=noreply@rmwllc-consulting.com

# SMTP_USER and SMTP_PASSWORD are injected via Kubernetes secret (from Vault)
# Leave blank for local dev with Mailpit (no auth required)
SMTP_USER=
SMTP_PASSWORD=

# ─── Contact form destination ────────────────────────────────────────────────
CONTACT_EMAIL=ryanwaite28@gmail.com
